{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 410,
  "title": {
    "text": "Income and School Density by District",
    "subtitle": [
      "Extreme school-density outliers above 120 schools per 10,000 residents are trimmed to make the main pattern readable."
    ]
  },
  "data": {
    "url": "data/master_district_2022_mapready.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.income_median) && isValid(datum.schools_per_10000)"
    },
    {
      "filter": "datum.schools_per_10000 <= 120"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 65,
        "opacity": 0.72
      },
      "encoding": {
        "x": {
          "field": "schools_per_10000",
          "type": "quantitative",
          "title": "Schools per 10,000 residents"
        },
        "y": {
          "field": "income_median",
          "type": "quantitative",
          "title": "Median household income (RM)"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "district",
            "type": "nominal",
            "title": "District"
          },
          {
            "field": "schools_per_10000",
            "type": "quantitative",
            "title": "Schools per 10,000",
            "format": ".1f"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "income_median",
          "on": "schools_per_10000"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#111827",
        "strokeWidth": 2.2
      },
      "encoding": {
        "x": {
          "field": "schools_per_10000",
          "type": "quantitative"
        },
        "y": {
          "field": "income_median",
          "type": "quantitative"
        }
      }
    }
  ]
}