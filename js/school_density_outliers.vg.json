{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 420,
  "title": {
    "text": "Districts with Unusually High School Density",
    "subtitle": [
      "These districts would dominate an unfiltered school-density chart and distort broader comparisons."
    ]
  },
  "data": {
    "url": "data/master_district_2022_mapready.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.schools_per_10000)"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rownum"
        }
      ],
      "sort": [
        {
          "field": "schools_per_10000",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rownum <= 10"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "district",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "schools_per_10000",
          "type": "quantitative",
          "title": "Schools per 10,000 residents"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 11
      },
      "encoding": {
        "y": {
          "field": "district",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "schools_per_10000",
          "type": "quantitative"
        },
        "text": {
          "field": "schools_per_10000",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}